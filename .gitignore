# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Security - never commit API keys
.tmp_key_*
*.key
*.secret
.env
.claude/

# local scratch / probe helpers (agent tooling, archive outside the repo)
/_*.mjs
/_*.json
/_*.txt
/_*.log
/_*.py
/_*.jpg
/_tmp_out*
/_refs/
/_expand/
/_tmp_seo/
